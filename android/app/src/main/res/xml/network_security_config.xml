<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow HTTPS everywhere; cleartext only for local/dev hosts if needed. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
